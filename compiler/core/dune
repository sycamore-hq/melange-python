(library
 (name melangelib)
 (modes native)
 (flags
  :standard
  -w
  -58
  -warn-error
  -58
  (:include cmi_flags.sexp))
 (libraries
  melange.__private__.melstd
  melange.__private__.melange_compiler_libs
  melange.__private__.melange_ffi
  melange.__private__.pp
  ppxlib.ast
  dune-build-info))

(rule
 (targets cmi_flags.sexp)
 (deps ../gen_cmi_flags.sh)
 (action
  (bash "sh ../gen_cmi_flags.sh %{targets}")))

(rule
 (targets compile_letrec.ml)
 (deps compile_letrec.520.ml)
 (action
  (copy %{deps} %{targets}))
 (enabled_if
  (>= %{ocaml_version} 5.2.0)))

