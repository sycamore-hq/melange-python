(rule
 (target include_dirs.ml)
 (deps include_dirs.dev.ml include_dirs.release.ml)
 (action
  (copy# include_dirs.%{profile}.ml %{target}))
 (enabled_if
  (or
   (= %{profile} dev)
   (= %{profile} release))))

(rule
 (target include_dirs.ml)
 (deps include_dirs.dev.ml include_dirs.release.ml)
 (action
  (copy# include_dirs.release.ml %{target}))
 (enabled_if
  (not
   (or
    (= %{profile} dev)
    (= %{profile} release)))))

